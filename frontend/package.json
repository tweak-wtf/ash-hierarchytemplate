{
  "name": "ayon-addon-full-template",
  "private": true,
  "version": "0.3.0-dev",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/@ynput/ayon-addon-dev/dist/cli.js dev",
    "dev:ayon": "node ./node_modules/@ynput/ayon-addon-dev/dist/cli.js dev --ayon",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "generate-token": "node --env-file=.env.local ./gen/getAuth.js",
    "generate-gql": "cd gen && graphql-codegen --require dotenv/config",
    "generate-rest": "node ./node_modules/@ynput/ayon-addon-dev/dist/cli.js generate-rest",
    "copy-shared": "node ./scripts/copyShared.js",
    "ayon-addon": "node ./node_modules/@ynput/ayon-addon-dev/dist/cli.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.0.8",
    "@dnd-kit/sortable": "^8.0.0",
    "@module-federation/enhanced": "2.3.2",
    "@reduxjs/toolkit": "^2.7.0",
    "@rtk-query/graphql-request-base-query": "^2.3.1",
    "@tanstack/react-table": "^8.21.3",
    "@ynput/ayon-addon": "^0.3.0",
    "@ynput/ayon-frontend-shared": "^0.8.0",
    "@ynput/ayon-react-components": "^1.25.1",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "query-string": "^9.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.0.0",
    "react-toastify": "^9.0.3",
    "styled-components": "6.1.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/near-operation-file-preset": "^4.0.0",
    "@graphql-codegen/typed-document-node": "^6.1.4",
    "@graphql-codegen/typescript": "^5.0.6",
    "@graphql-codegen/typescript-operations": "^5.0.6",
    "@graphql-codegen/typescript-rtk-query": "^3.1.2",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@module-federation/vite": "^1.14.2",
    "@rtk-query/codegen-openapi": "2.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@ynput/ayon-addon-dev": "^0.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "use-query-params": "^2.2.2",
    "vite": "^7.2.4"
  },
  "graphql": {
    "schema": "./gen/graphql.schema.json",
    "documents": "**/*.graphql"
  }
}
